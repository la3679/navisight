# NaviSight — environment template
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# Nothing in this file is a secret. Real secrets belong only in your local
# `.env`. Never place a secret in a NEXT_PUBLIC_* variable — those are inlined
# into the browser bundle.

# ---------------------------------------------------------------------------
# Source data
# ---------------------------------------------------------------------------
# Path to the raw AIS CSV. The file is NOT part of this repository (~577 MiB).
# See data/README.md for how to obtain it.
#
# Keep it OUTSIDE the repository. A relative path is resolved from the repo
# root. Use forward slashes on Windows; they work fine.
AIS_DATA_PATH=../ais-2025-01-08.csv

# Human-readable label recorded on ingested documents for provenance.
AIS_DATASET_NAME=NOAA/USCG AIS

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Local development, either a native install or `docker compose up -d mongodb`.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=navisight

# Separate database used by integration tests. It is DROPPED between runs, so
# it must never point at a database holding data you care about.
MONGODB_TEST_DATABASE=navisight_test

# Host port the Docker MongoDB binds to. Change this if you already run a
# native mongod on 27017 (then set MONGODB_URI to mongodb://localhost:27018).
MONGO_HOST_PORT=27017

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# json | console  — `console` is friendlier locally, `json` is for aggregation.
LOG_FORMAT=console

API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Public by design: the browser needs to know where the API is.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. A raster/vector basemap style URL for MapLibre. Left empty, the app
# uses a bundled offline-friendly style with no third-party tile requests.
NEXT_PUBLIC_MAP_STYLE_URL=

# ---------------------------------------------------------------------------
# AI copilot (optional)
# ---------------------------------------------------------------------------
# The application starts and runs fully without these. AI surfaces then render
# an explicit "provider not configured" state instead of failing.
#
# LLM_PROVIDER: anthropic | openai | mock | (empty = AI disabled)
#   `mock` is a deterministic offline provider used by tests and demos.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Guardrails on agent execution. Lower these if you want tighter cost control.
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=60
